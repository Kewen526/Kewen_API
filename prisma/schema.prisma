// Prisma Schema for Kewen API Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  password      String
  role          UserRole       @default(USER)
  status        UserStatus     @default(ACTIVE)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?

  // Relations
  dataSources   DataSource[]
  apis          Api[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  scheduledJobs ScheduledJob[]
  apiLogs       ApiLog[]
  teams         TeamMember[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Team Management
model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Data Source Management
model DataSource {
  id            String           @id @default(uuid())
  name          String
  type          DataSourceType
  host          String
  port          Int
  database      String
  username      String
  password      String           // Encrypted
  ssl           Boolean          @default(false)
  sslConfig     Json?
  options       Json?
  status        DataSourceStatus @default(ACTIVE)
  description   String?
  createdBy     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastTestedAt  DateTime?

  user          User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  apis          Api[]
  sqlHistories  SqlHistory[]

  @@map("data_sources")
}

enum DataSourceType {
  MYSQL
  POSTGRESQL
  MONGODB
  REDIS
  SQL_SERVER
  SQLITE
  ORACLE
  CLICKHOUSE
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

// API Management
model Api {
  id              String        @id @default(uuid())
  name            String
  path            String
  method          HttpMethod
  version         String        @default("v1")
  dataSourceId    String
  sql             String        @db.Text
  parameters      Json?         // Parameter definitions
  responseMapping Json?         // Response transformation rules
  cacheEnabled    Boolean       @default(false)
  cacheTtl        Int?          // Cache TTL in seconds
  rateLimitEnabled Boolean      @default(true)
  rateLimit       Int?          // Requests per minute
  ipWhitelist     String[]      @default([])
  requireAuth     Boolean       @default(true)
  status          ApiStatus     @default(DRAFT)
  description     String?
  tags            String[]      @default([])
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  dataSource      DataSource    @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  versions        ApiVersion[]
  logs            ApiLog[]
  metrics         ApiMetric[]

  @@unique([path, method, version])
  @@index([status])
  @@index([createdBy])
  @@map("apis")
}

enum HttpMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
}

enum ApiStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

// API Version Control
model ApiVersion {
  id          String   @id @default(uuid())
  apiId       String
  version     String
  sql         String   @db.Text
  config      Json
  changelog   String?
  createdBy   String
  createdAt   DateTime @default(now())

  api         Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@index([apiId])
  @@map("api_versions")
}

// API Key Management
model ApiKey {
  id          String      @id @default(uuid())
  name        String
  key         String      @unique
  userId      String
  permissions Json?       // API access permissions
  expiresAt   DateTime?
  status      KeyStatus   @default(ACTIVE)
  lastUsedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@map("api_keys")
}

enum KeyStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// API Logging
model ApiLog {
  id              String   @id @default(uuid())
  apiId           String
  userId          String?
  method          String
  path            String
  query           Json?
  body            Json?
  headers         Json?
  statusCode      Int
  responseTime    Int      // milliseconds
  ip              String
  userAgent       String?
  errorMessage    String?
  createdAt       DateTime @default(now())

  api             Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([apiId])
  @@index([createdAt])
  @@index([statusCode])
  @@map("api_logs")
}

// API Metrics
model ApiMetric {
  id              String   @id @default(uuid())
  apiId           String
  date            DateTime @db.Date
  totalRequests   Int      @default(0)
  successRequests Int      @default(0)
  failedRequests  Int      @default(0)
  avgResponseTime Float    @default(0)
  maxResponseTime Int      @default(0)
  minResponseTime Int      @default(0)

  api             Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@unique([apiId, date])
  @@index([date])
  @@map("api_metrics")
}

// SQL Execution History
model SqlHistory {
  id            String     @id @default(uuid())
  dataSourceId  String
  sql           String     @db.Text
  parameters    Json?
  executionTime Int        // milliseconds
  rowsAffected  Int?
  status        ExecStatus
  errorMessage  String?
  createdBy     String
  createdAt     DateTime   @default(now())

  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId])
  @@index([createdAt])
  @@map("sql_histories")
}

enum ExecStatus {
  SUCCESS
  FAILED
}

// Webhook Management
model Webhook {
  id          String        @id @default(uuid())
  name        String
  url         String
  method      String        @default("POST")
  headers     Json?
  events      String[]      @default([]) // API call, data change, etc.
  secret      String?
  enabled     Boolean       @default(true)
  retryTimes  Int           @default(3)
  timeout     Int           @default(10000)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  logs        WebhookLog[]

  @@map("webhooks")
}

model WebhookLog {
  id          String   @id @default(uuid())
  webhookId   String
  event       String
  payload     Json
  statusCode  Int?
  response    String?
  errorMessage String?
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())

  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_logs")
}

// Scheduled Jobs
model ScheduledJob {
  id            String    @id @default(uuid())
  name          String
  description   String?
  cronExpression String
  sql           String    @db.Text
  dataSourceId  String
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  executions    JobExecution[]

  @@map("scheduled_jobs")
}

model JobExecution {
  id            String        @id @default(uuid())
  jobId         String
  status        ExecStatus
  startTime     DateTime
  endTime       DateTime?
  executionTime Int?          // milliseconds
  rowsAffected  Int?
  errorMessage  String?

  job           ScheduledJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([startTime])
  @@map("job_executions")
}

// Data Import/Export
model ImportExportJob {
  id          String          @id @default(uuid())
  type        JobType
  format      FileFormat
  filePath    String
  status      JobStatus
  totalRows   Int?
  processedRows Int?
  errorRows   Int?
  errorLog    String?
  config      Json?
  createdBy   String
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("import_export_jobs")
}

enum JobType {
  IMPORT
  EXPORT
}

enum FileFormat {
  CSV
  EXCEL
  JSON
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
